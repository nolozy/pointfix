{
  "manifest_version": 3,
  "name": "Pointfix",
  "short_name": "Pointfix",
  "version": "0.2.0",
  "description": "Point at any part of a web page and copy a ready-to-paste prompt for your AI agent.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Pointfix: click to show or hide the bar",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "exclude_matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "http://127.0.0.1:8790/ai.html"
      ]
    }
  ],
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "commands": {
    "toggle-point": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Start or stop Point mode"
    },
    "copy-prompt": {
      "suggested_key": {
        "default": "Alt+C"
      },
      "description": "Copy the prompt"
    },
    "delete-all": {
      "suggested_key": {
        "default": "Alt+X"
      },
      "description": "Delete all points"
    }
  }
}
